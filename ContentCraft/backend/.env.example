# ContentCraft Environment Configuration

# SQL Server
DB_SERVER=.\SQLEXPRESS02
DB_NAME=ContentCraftDB
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# Meta Facebook Graph API (Dành cho đăng bài tự động lên Fanpage Facebook thật)
# 1. Truy cập https://developers.facebook.com/ tạo App
# 2. Vào Graph API Explorer lấy Page Access Token với quyền: pages_manage_posts, pages_read_engagement
# 3. Lấy Page ID từ mục Giới thiệu (About) của Fanpage
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Webhook Automation (Dành cho đăng bài tự động qua Make.com, Zapier, n8n, Telegram Bot)
# Điền webhook URL tại đây để tự động nhận nội dung bài viết ngay khi bạn bấm xuất bản
PUBLISHING_WEBHOOK_URL=

# AI Text Generation Configuration (OpenAI & Google Gemini)
# Chọn nhà cung cấp: gemini hoặc openai (hệ thống có cơ chế tự động fallback nếu 1 bên gặp sự cố)
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
